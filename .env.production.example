# ACG Trader frontend — production PUBLIC browser configuration only.
# Values prefixed VITE_ are embedded in the browser bundle.
# Never place secret/service-role keys, database credentials, or API secrets in this file.
# Supabase personal authentication uses only the project's publishable browser key.

# Production backend API origin (replace with your actual Railway HTTPS URL).
VITE_ACG_TRADER_API_BASE=https://acg-trader-backend-production.up.railway.app

# Optional: if omitted, derives wss://<API-host>/v1/ws.
# VITE_ACG_TRADER_WS_URL=wss://acg-trader-backend-production.up.railway.app/v1/ws

VITE_ACG_TRADER_HTTP_TIMEOUT_MS=10000

# Existing ACG Funded trading-account login.
VITE_ACG_TRADER_TENANT=acg-funded
VITE_ACG_FUNDED_URL=https://acgfunded.com

# Personal signup is disabled unless explicitly activated after acceptance.
VITE_ACG_SUPABASE_AUTH_ENABLED=false
