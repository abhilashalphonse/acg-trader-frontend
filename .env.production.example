# ACG Trader frontend — production build environment
# Vite variables are public at build time. Never put private API keys here.

# Required. Use the public HTTPS origin of acg-trader-backend.
VITE_ACG_TRADER_API_BASE=https://your-acg-trader-backend.example

# Optional. Omit this to derive wss://<api-host>/v1/ws automatically.
# VITE_ACG_TRADER_WS_URL=wss://your-acg-trader-backend.example/v1/ws

VITE_ACG_TRADER_HTTP_TIMEOUT_MS=10000
