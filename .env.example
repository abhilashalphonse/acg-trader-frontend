# GoCharting commercial SDK license
VITE_GOCHARTING_LICENSE_KEY=

# ACG market-data gateway. Keep provider credentials server-side.
# REST contract:
# GET /market/quotes?symbols=AUDCAD,EURUSD
# GET /market/bars?symbol=AUDCAD&interval=1&from=<unix>&to=<unix>
VITE_MARKET_DATA_URL=

# WebSocket contract:
# client -> {"type":"subscribe","symbol":"AUDCAD"}
# server -> {"symbol":"AUDCAD","bid":0.99368,"ask":0.99373,"time":<unix-ms>,"change":"-0.11%"}
VITE_MARKET_WS_URL=
