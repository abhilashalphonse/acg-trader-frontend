# ACG Trader frontend / Vite
# Copy this file to .env for local development.
# Never place market-provider credentials or trading access tokens in Vite environment variables.

VITE_ACG_TRADER_API_BASE=http://localhost:4000
# Optional. When omitted, the client derives ws://localhost:4000/v1/ws from API_BASE.
# VITE_ACG_TRADER_WS_URL=ws://localhost:4000/v1/ws
# Optional HTTP timeout in milliseconds.
# VITE_ACG_TRADER_HTTP_TIMEOUT_MS=10000
