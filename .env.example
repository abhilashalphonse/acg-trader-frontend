# ACG Trader frontend — local development PUBLIC browser configuration only.
# VITE_ settings are exposed to users. Never place secret keys or passwords here.
VITE_ACG_TRADER_API_BASE=http://localhost:4000
VITE_ACG_TRADER_WS_URL=ws://localhost:4000/v1/ws
VITE_ACG_TRADER_HTTP_TIMEOUT_MS=10000

# Default ACG Funded credentials login.
VITE_ACG_TRADER_TENANT=acg-funded
VITE_ACG_FUNDED_URL=https://acgfunded.com

# Keep standalone personal onboarding disabled until approved for production.
VITE_ACG_SUPABASE_AUTH_ENABLED=false
